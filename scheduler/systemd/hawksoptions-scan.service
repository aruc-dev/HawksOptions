[Unit]
Description=HawksOptions scan
After=network-online.target hawksoptions-secrets.service

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/HawksOptions
EnvironmentFile=/etc/hawksoptions/hawksoptions.env
ExecStart=/home/ec2-user/HawksOptions/scripts/run_hawksoptions_job.sh scheduler/run_scan.py
TimeoutStartSec=30min
Restart=no
