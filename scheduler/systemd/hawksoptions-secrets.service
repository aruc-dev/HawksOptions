[Unit]
Description=HawksOptions /dev/shm secret loader
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/HawksOptions
EnvironmentFile=/etc/hawksoptions/hawksoptions.env
PassEnvironment=HAWKSOPTIONS_SECRETS_FORCE_REFRESH HAWKSOPTIONS_SECRETS_MAX_AGE_SECONDS
ExecStartPre=+/usr/bin/bash -lc 'file="${HAWKSOPTIONS_SHM_SECRET_FILE:-/dev/shm/.hawksoptions.env}"; if [ -e "$file" ]; then chown ec2-user:ec2-user "$file" && chmod 0600 "$file"; fi'
ExecStart=/home/ec2-user/HawksOptions/scripts/fetch_secrets.sh

[Install]
WantedBy=multi-user.target
